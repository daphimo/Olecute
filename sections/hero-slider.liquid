{{ 'hero-slider.css' | asset_url | stylesheet_tag }}
{% render 'brand-colors', scope: '.olecute-hero' %}
<script src="{{ 'hero-slider.js' | asset_url }}" type="module"></script>

{% if section.blocks.size > 0 %}
  <olecute-hero
    id="OlecuteHero-{{ section.id }}"
    class="splide olecute-hero"
    role="region"
    aria-label="Featured collections"
    data-type="{{ section.settings.slide_type }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
    data-pagination="{{ section.settings.show_pagination }}"
    data-navigation="{{ section.settings.show_navigation }}"
  >
    <div class="splide__track olecute-hero__track">
      <ul class="splide__list olecute-hero__list">
        {% for block in section.blocks %}
          {% render 'hero-slider-slide', block: block, first: forloop.first %}
        {% endfor %}
      </ul>
    </div>
    {% if section.blocks.size > 1 %}
      {% render 'hero-slider-controls', section: section %}
    {% endif %}
  </olecute-hero>
{% elsif request.design_mode %}
  <div class="olecute-hero olecute-hero--empty">
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'olecute-hero__placeholder' }}
    <p class="olecute-hero__empty-message">Add a slide and choose desktop and mobile images.</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Olecute hero slider",
  "tag": "section",
  "class": "olecute-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": true },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 0, "max": 100, "step": 1, "unit": "s", "default": 6 },
    {
      "type": "select", "id": "slide_type", "label": "Slide type", "default": "loop",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "loop", "label": "Loop" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Uses the desktop image when left empty." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_label", "label": "Button label" }
      ]
    }
  ],
  "presets": [{ "name": "Olecute hero slider", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
