{{ 'custom-footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-footer.js' | asset_url }}" defer></script>

{% liquid
  assign current_year = 'now' | date: '%Y'
  assign social_keys = 'instagram,facebook,pinterest,youtube' | split: ','
  assign social_count = 0
  for social_key in social_keys
    assign setting_key = social_key | append: '_url'
    if section.settings[setting_key] != blank
      assign social_count = social_count | plus: 1
    endif
  endfor
%}

<custom-footer
  class="custom-footer"
  style="
    --custom-footer-bg: {{ section.settings.background_color }};
    --custom-footer-wave-height: {{ section.settings.wave_height }}px;
    --custom-footer-wave-height-mobile: {{ section.settings.mobile_wave_height }}px;
    --custom-footer-padding-top: {{ section.settings.padding_top }}px;
    --custom-footer-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-footer-padding-top-mobile: {{ section.settings.mobile_padding_top }}px;
    --custom-footer-padding-bottom-mobile: {{ section.settings.mobile_padding_bottom }}px;
    --custom-footer-logo-width: {{ section.settings.logo_width }}px;
  "
  {{ section.shopify_attributes }}
>
  {% if section.settings.show_wave %}
    <div class="custom-footer__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false">
        <path d="M0 0H1440V57C1380 43 1330 43 1270 58C1210 73 1160 77 1095 61C1030 45 985 42 925 56C865 70 810 79 745 64C680 49 635 43 575 56C515 69 460 78 395 64C330 50 285 45 225 58C165 71 100 75 0 55V0Z" transform="translate(0 80) scale(1 -1)"/>
      </svg>
    </div>
  {% endif %}

  <footer class="custom-footer__body">
    <div class="custom-footer__inner">
      <div class="custom-footer__intro">
        <div class="custom-footer__brand">
          <a class="custom-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
            {% if section.settings.logo != blank %}
              {{ section.settings.logo | image_url: width: 720 | image_tag: widths: '160, 240, 320, 480, 640, 720', sizes: '(max-width: 749px) 160px, var(--custom-footer-logo-width)', loading: 'lazy', alt: shop.name }}
            {% else %}
              <span>{{ shop.name | escape }}</span>
            {% endif %}
          </a>
          {% if section.settings.brand_description != blank %}
            <div class="custom-footer__description rte">{{ section.settings.brand_description }}</div>
          {% endif %}
        </div>

        {% if section.settings.secondary_logo != blank or section.settings.secondary_tagline != blank %}
          <div class="custom-footer__secondary">
            {% if section.settings.secondary_logo != blank %}
              {{ section.settings.secondary_logo | image_url: width: 480 | image_tag: widths: '120, 180, 240, 360, 480', sizes: '(max-width: 749px) 140px, 200px', loading: 'lazy', alt: section.settings.secondary_logo.alt | default: shop.name }}
            {% endif %}
            {% if section.settings.secondary_tagline != blank %}
              <div class="custom-footer__tagline rte">{{ section.settings.secondary_tagline }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="custom-footer__menus">
          {% for block in section.blocks %}
            {% liquid
              assign menu = block.settings.menu
              assign whatsapp_number = block.settings.whatsapp_number
              assign whatsapp_url = whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
              assign has_contact = false
              if block.settings.show_contact
                if whatsapp_number != blank or block.settings.email != blank or block.settings.store_hours != blank
                  assign has_contact = true
                endif
              endif
            %}
            {% if block.settings.heading != blank or menu.links.size > 0 or has_contact %}
              <section class="custom-footer__menu" {{ block.shopify_attributes }}>
                <button
                  class="custom-footer__menu-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls="CustomFooterMenu-{{ section.id }}-{{ block.id }}"
                >
                  <span>{{ block.settings.heading | default: menu.title | escape }}</span>
                  <svg class="custom-footer__accordion-icon" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                    <path class="custom-footer__accordion-line" d="M3 9h12"/>
                    <path class="custom-footer__accordion-line custom-footer__accordion-line--vertical" d="M9 3v12"/>
                  </svg>
                </button>

                <div class="custom-footer__menu-content" id="CustomFooterMenu-{{ section.id }}-{{ block.id }}">
                  <div class="custom-footer__menu-content-inner">
                    {% if block.settings.heading != blank %}
                      <h2 class="custom-footer__menu-heading">{{ block.settings.heading | escape }}</h2>
                    {% endif %}

                    {% if menu.links.size > 0 %}
                      <nav aria-label="{{ block.settings.heading | default: menu.title | escape }}">
                        <ul class="custom-footer__links" role="list">
                          {% for link in menu.links %}
                            <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                          {% endfor %}
                        </ul>
                      </nav>
                    {% endif %}

                    {% if has_contact %}
                      <address class="custom-footer__contact">
                        {% if whatsapp_number != blank %}
                          <div class="custom-footer__contact-item">
                            {% if block.settings.whatsapp_label != blank %}<span>{{ block.settings.whatsapp_label | escape }}</span>{% endif %}
                            <a href="https://wa.me/{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ whatsapp_number | escape }}</a>
                          </div>
                        {% endif %}
                        {% if block.settings.email != blank %}
                          <div class="custom-footer__contact-item">
                            {% if block.settings.email_label != blank %}<span>{{ block.settings.email_label | escape }}</span>{% endif %}
                            <a href="mailto:{{ block.settings.email | url_encode }}">{{ block.settings.email | escape }}</a>
                          </div>
                        {% endif %}
                        {% if block.settings.store_hours != blank %}
                          <div class="custom-footer__contact-item">
                            {% if block.settings.store_hours_label != blank %}<span>{{ block.settings.store_hours_label | escape }}</span>{% endif %}
                            <p>{{ block.settings.store_hours | escape | newline_to_br }}</p>
                          </div>
                        {% endif %}
                      </address>
                    {% endif %}
                  </div>
                </div>
              </section>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="custom-footer__bottom">
        <p class="custom-footer__copyright">&copy; {{ current_year }} {{ shop.name | escape }}{% if section.settings.copyright_text != blank %}. {{ section.settings.copyright_text | escape }}{% endif %}</p>

        {% if social_count > 0 %}
          <div class="custom-footer__social" aria-label="Social media links">
            {% for social_key in social_keys %}
              {% assign setting_key = social_key | append: '_url' %}
              {% assign social_url = section.settings[setting_key] %}
              {% if social_url != blank %}
                <a href="{{ social_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social_key | capitalize }}">
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">{% render 'icon', icon: social_key %}</svg>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.legal_menu.links.size > 0 %}
          <nav class="custom-footer__legal" aria-label="Legal">
            <ul role="list">
              {% for link in section.settings.legal_menu.links %}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>
    </div>
  </footer>
</custom-footer>

{% schema %}
{
  "name": "Custom footer",
  "tag": "section",
  "class": "custom-footer-section",
  "max_blocks": 4,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f8edf2" },
    { "type": "image_picker", "id": "logo", "label": "Footer logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 100, "max": 300, "step": 10, "unit": "px", "default": 180 },
    { "type": "richtext", "id": "brand_description", "label": "Brand description", "default": "<p>Thoughtfully made pieces designed to feel as beautiful as they look — inside and out.</p>" },
    { "type": "image_picker", "id": "secondary_logo", "label": "Secondary logo" },
    { "type": "richtext", "id": "secondary_tagline", "label": "Secondary tagline", "default": "<p>Indian soul.<br>Modern spirit.</p>" },
    { "type": "header", "content": "Wave" },
    { "type": "checkbox", "id": "show_wave", "label": "Show top wave", "default": true },
    { "type": "range", "id": "wave_height", "label": "Desktop wave height", "min": 40, "max": 140, "step": 5, "unit": "px", "default": 85 },
    { "type": "range", "id": "mobile_wave_height", "label": "Mobile wave height", "min": 24, "max": 90, "step": 3, "unit": "px", "default": 48 },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "All rights reserved." },
    { "type": "link_list", "id": "legal_menu", "label": "Footer legal menu" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 40, "max": 140, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 32, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Menu" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "checkbox", "id": "show_contact", "label": "Enable contact information", "default": false },
        { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "WHATSAPP", "visible_if": "{{ block.settings.show_contact }}" },
        { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "visible_if": "{{ block.settings.show_contact }}" },
        { "type": "text", "id": "email_label", "label": "Email label", "default": "EMAIL", "visible_if": "{{ block.settings.show_contact }}" },
        { "type": "text", "id": "email", "label": "Email address", "visible_if": "{{ block.settings.show_contact }}" },
        { "type": "text", "id": "store_hours_label", "label": "Store hours label", "default": "STORE HOURS", "visible_if": "{{ block.settings.show_contact }}" },
        { "type": "textarea", "id": "store_hours", "label": "Store hours", "visible_if": "{{ block.settings.show_contact }}" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom footer",
      "category": "Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "SHOP" } },
        { "type": "menu_column", "settings": { "heading": "INFORMATION" } },
        { "type": "menu_column", "settings": { "heading": "POLICIES" } },
        { "type": "menu_column", "settings": { "heading": "CUSTOMER CARE", "show_contact": true } }
      ]
    }
  ]
}
{% endschema %}
