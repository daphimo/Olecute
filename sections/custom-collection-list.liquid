{{ 'custom-collection-list.css' | asset_url | stylesheet_tag }}

{% liquid
  case section.settings.mobile_cards_per_view
    when 'one'
      assign mobile_card_width = '86%'
    when 'one_peek'
      assign mobile_card_width = '76%'
    when 'one_half'
      assign mobile_card_width = '62%'
    when 'two'
      assign mobile_card_width = '46%'
  endcase
%}

<section
  class="custom-collection-list"
  style="
    --custom-collection-columns: {{ section.settings.desktop_columns }};
    --custom-collection-gap: {{ section.settings.card_gap }}px;
    --custom-collection-mobile-width: {{ mobile_card_width }};
    --custom-collection-padding-top: {{ section.settings.padding_top }}px;
    --custom-collection-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-collection-margin-top: {{ section.settings.margin_top }}px;
    --custom-collection-margin-bottom: {{ section.settings.margin_bottom }}px;
  "
>
  <div class="custom-collection-list__inner">
    {% if section.settings.heading != blank %}
      <h2 class="custom-collection-list__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="custom-collection-list__rail" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign collection = block.settings.collection
            assign collection_image = collection.image
            if collection_image == blank and collection.products.first.featured_image != blank
              assign collection_image = collection.products.first.featured_image
            endif
            assign collection_title = collection.title | default: 'Collection'
            assign collection_alt = collection_image.alt | default: collection_title
            assign collection_url = collection.url | default: routes.collections_url
            assign image_loading = 'lazy'
          %}
          <li class="custom-collection-list__item" {{ block.shopify_attributes }}>
            <article class="custom-collection-list__card">
              <a class="custom-collection-list__link" href="{{ collection_url }}" aria-label="{{ collection_title | escape }}">
                {% if collection_image != blank %}
                  {{ collection_image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'custom-collection-list__image',
                      widths: '240, 360, 480, 600, 750, 900, 1000',
                      sizes: '(max-width: 749px) 76vw, (max-width: 1199px) 30vw, 20vw',
                      loading: image_loading,
                      alt: collection_alt
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'custom-collection-list__placeholder' }}
                {% endif %}
                <span class="custom-collection-list__label">
                  <span class="custom-collection-list__title">{{ collection_title | escape }}</span>
                  <span class="custom-collection-list__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                  </span>
                </span>
              </a>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}
      <p class="custom-collection-list__empty">Add collection blocks to populate this section.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom collection list",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by categories" },
    { "type": "range", "id": "desktop_columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 5 },
    {
      "type": "select",
      "id": "mobile_cards_per_view",
      "label": "Mobile cards per view",
      "options": [
        { "value": "one", "label": "1" },
        { "value": "one_peek", "label": "1 with next card visible" },
        { "value": "one_half", "label": "1.5" },
        { "value": "two", "label": "2" }
      ],
      "default": "one_peek"
    },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Section margins" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "Custom collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
