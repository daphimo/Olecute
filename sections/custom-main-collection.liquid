{{ 'custom-main-collection.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'custom-main-collection.js' | asset_url }}"></script>
{% render 'brand-colors', scope: '.custom-main-collection, .custom-main-collection__drawer' %}
{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
{% capture clear_url %}{{ collection.url }}?sort_by={{ sort_by | url_encode }}{% endcapture %}
<custom-main-collection class="custom-main-collection custom-commerce{% if collection.image != blank %} custom-main-collection--has-banner{% endif %}" data-section-id="{{ section.id }}" data-loading="{{ section.settings.product_loading }}" style="--collection-columns: {{ section.settings.desktop_columns }};">
  {% paginate collection.products by section.settings.products_per_page %}
    {% if collection.image != blank %}
      <div class="custom-main-collection__mobile-banner">
        {{ collection.image | image_url: width: 1000 | image_tag: widths: '390, 550, 750, 1000', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
        <span>{{ collection.title | escape }}</span>
      </div>
    {% endif %}
    <header class="custom-main-collection__header">
      <div><h1 class="custom-main-collection__heading">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="custom-main-collection__description rte">{{ collection.description }}</div>{% endif %}</div>
      <div class="custom-main-collection__toolbar">
        <label class="custom-main-collection__sort" for="CollectionSort-{{ section.id }}">Sort by
          <select id="CollectionSort-{{ section.id }}" name="sort_by" form="CollectionFilters-{{ section.id }}" data-collection-sort>{% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if sort_by == option.value %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>
        </label>
        <noscript><button type="submit" form="CollectionFilters-{{ section.id }}">Sort products</button></noscript>
        <div class="custom-main-collection__controls" data-mobile-toolbar><span data-result-count>{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>{% if section.settings.enable_filters and collection.filters.size > 0 %}<button type="button" data-filter-open aria-haspopup="dialog" aria-expanded="false" aria-controls="CollectionDrawer-{{ section.id }}" hidden>Filter <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M6 10h8M8 15h4"/></svg></button>{% endif %}</div>
      </div>
    </header>
    <div class="custom-main-collection__status"><p role="status" aria-live="polite" data-collection-status></p><button type="button" data-collection-retry hidden>Try again</button></div>
    {% if section.settings.show_subcollections %}
      {% capture subcollections %}{% for subcollection in collection.metafields.custom.sub_collections.value %}{% if subcollection.url != blank %}<a class="custom-main-collection__pill" href="{{ subcollection.url }}" {% if subcollection.id == collection.id %}aria-current="page"{% endif %}><span class="custom-main-collection__pill-media">{% if subcollection.image != blank %}{{ subcollection.image | image_url: width: 360 | image_tag: widths: '120, 180, 240, 360', sizes: '25vw', loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</span><span class="custom-main-collection__pill-title">{{ subcollection.title | escape }}</span></a>{% endif %}{% endfor %}{% endcapture %}
      {% assign subcollections = subcollections | strip %}{% if subcollections != blank %}<nav class="custom-main-collection__subcollections" aria-label="Collections">{{ subcollections }}</nav>{% endif %}
    {% endif %}
    <div data-filter-panel class="custom-main-collection__filter-panel">
      <form id="CollectionFilters-{{ section.id }}" action="{{ request.path }}" method="get" data-collection-filters>
        {% if section.settings.enable_filters %}{% for filter in collection.filters %}{% render 'custom-collection-filter', filter: filter, section_id: section.id, index: forloop.index %}{% endfor %}{% endif %}
        <div class="custom-main-collection__filter-actions"><a href="{{ clear_url }}" data-collection-clear>Clear all</a><button type="submit">Apply filters</button></div>
      </form>
    </div>
    <div class="custom-main-collection__active" aria-label="Active filters">
      {% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}" data-collection-nav>{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">&#215;</span></a>{% endfor %}
        {% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}" data-collection-nav>{{ filter.label | escape }}: {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">&#215;</span></a>{% endif %}{% endif %}
      {% endfor %}
    </div>
    <div data-collection-results tabindex="-1">
      <ul class="custom-main-collection__grid" data-collection-grid role="list">
        {% for product in collection.products %}<li data-product-id="{{ product.id }}">{% assign eager = false %}{% if forloop.index <= 4 %}{% assign eager = true %}{% endif %}{% render 'custom-product-card', product: product, eager: eager %}</li>{% endfor %}
      </ul>
      {% if collection.products_count == 0 %}<div class="custom-main-collection__empty"><h2>No products found</h2><p>Try another selection or clear your filters.</p><a href="{{ clear_url }}" data-collection-clear>Clear filters</a></div>{% endif %}
      <div data-collection-pagination>
        {% if section.settings.product_loading == 'infinite' %}{% if paginate.next %}<a href="{{ paginate.next.url }}" data-collection-next>Load more products</a>{% endif %}{% else %}{% render 'pagination-controls', paginate: paginate %}{% endif %}
      </div>
    </div>
    <div class="custom-main-collection__loader custom-main-collection__grid" data-collection-loader hidden aria-hidden="true">{% for i in (1..4) %}<div class="custom-main-collection__skeleton"><div></div><span></span><span></span></div>{% endfor %}</div>
  {% endpaginate %}
</custom-main-collection>
{% schema %}
{
  "name": "Custom main collection",
  "settings": [
    {"type":"select","id":"product_loading","label":"Product loading","options":[{"value":"pagination","label":"Pagination"},{"value":"infinite","label":"Infinite loading"}],"default":"pagination"},
    {"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":48,"step":4,"default":24},
    {"type":"range","id":"desktop_columns","label":"Desktop columns","min":2,"max":6,"step":1,"default":4},
    {"type":"checkbox","id":"enable_filters","label":"Enable filters","default":true},
    {"type":"checkbox","id":"show_subcollections","label":"Show subcollections","default":true}
  ],
  "presets":[{"name":"Custom main collection"}],
  "enabled_on":{"templates":["collection"]}
}
{% endschema %}
