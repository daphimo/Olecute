{{ 'custom-cta-banner.css' | asset_url | stylesheet_tag }}

<section
  class="custom-cta-banner"
  style="
    --custom-cta-background: {{ section.settings.background_color }};
    --custom-cta-radius: {{ section.settings.corner_radius }}px;
    --custom-cta-section-padding-top: {{ section.settings.padding_top }}px;
    --custom-cta-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-cta-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --custom-cta-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
  {% if section.settings.heading != blank %}
    aria-labelledby="CtaBannerHeading-{{ section.id }}"
  {% else %}
    aria-label="Call to action"
  {% endif %}
>
  <div class="custom-cta-banner__inner">
    <div class="custom-cta-banner__content">
      {% if section.settings.heading != blank %}
        <h2 id="CtaBannerHeading-{{ section.id }}" class="custom-cta-banner__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="custom-cta-banner__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="custom-cta-banner__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom CTA banner",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join a million women who've already made the switch" },
    { "type": "text", "id": "description", "label": "Description", "default": "Pure fabrics. Real fit. Delivered to your door." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F4B51B" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    {
      "name": "Custom CTA banner",
      "settings": { "button_link": "shopify://collections/all" }
    }
  ]
}
{% endschema %}
