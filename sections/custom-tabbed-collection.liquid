{{ 'custom-tabbed-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-tabbed-collection.js' | asset_url }}" type="module"></script>
{% render 'brand-colors', scope: '.custom-tabbed-collection' %}
<section class="custom-tabbed-collection custom-commerce" id="CustomTabbedCollection-{{ section.id }}" style="--tabbed-gap:{{ section.settings.gap }}px;--tabbed-mobile-gap:{{ section.settings.mobile_gap }}px;--tabbed-top:{{ section.settings.padding_top }}px;--tabbed-bottom:{{ section.settings.padding_bottom }}px;--tabbed-mobile-top:{{ section.settings.mobile_padding_top }}px;--tabbed-mobile-bottom:{{ section.settings.mobile_padding_bottom }}px">
  <custom-tabbed-collection class="custom-tabbed-collection__inner">
    {% if section.settings.heading != blank %}<h2 class="custom-tabbed-collection__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.blocks.size > 0 %}
      <div class="custom-tabbed-collection__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Product collections' | escape }}">
        {% for block in section.blocks %}
          <button class="custom-tabbed-collection__tab" id="Tab-{{ section.id }}-{{ block.id }}" type="button" role="tab" aria-controls="Panel-{{ section.id }}-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | default: 'Collection' | escape }}</button>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        {% assign tab_collection = block.settings.collection %}
        <div class="custom-tabbed-collection__panel" id="Panel-{{ section.id }}-{{ block.id }}" role="tabpanel" aria-labelledby="Tab-{{ section.id }}-{{ block.id }}" data-panel="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
          <div class="custom-tabbed-collection__grid">
            {% for product in tab_collection.products limit: block.settings.products_to_show %}
              {% render 'custom-product-card', product: product, eager: false %}
            {% else %}
              {% if request.design_mode %}<p class="custom-tabbed-collection__empty">Choose a collection with products for this tab.</p>{% endif %}
            {% endfor %}
          </div>
          {% if tab_collection != blank and block.settings.show_view_all or tab_collection != blank and block.settings.show_discover %}<a class="custom-tabbed-collection__view-all" href="{{ tab_collection.url }}">{{ block.settings.view_all_label | default: block.settings.discover_label | default: 'View all' | escape }}</a>{% endif %}
        </div>
      {% endfor %}
    {% elsif request.design_mode %}<p class="custom-tabbed-collection__empty">Add a collection tab to begin.</p>{% endif %}
  </custom-tabbed-collection>
</section>
{% schema %}
{
  "name": "Custom Tabbed Collection",
  "tag": "section",
  "class": "custom-tabbed-collection-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "gap", "label": "Desktop grid gap", "min": 4, "max": 40, "step": 2, "default": 14, "unit": "px" },
    { "type": "range", "id": "mobile_gap", "label": "Mobile grid gap", "min": 4, "max": 24, "step": 2, "default": 10, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Desktop top spacing", "min": 0, "max": 100, "step": 2, "default": 32, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom spacing", "min": 0, "max": 100, "step": 2, "default": 48, "unit": "px" },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top spacing", "min": 0, "max": 80, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom spacing", "min": 0, "max": 80, "step": 2, "default": 32, "unit": "px" }
    ,{ "type": "range", "id": "image_radius", "label": "Legacy image radius", "min": 0, "max": 60, "step": 2, "default": 16, "unit": "px" }
    ,{ "type": "select", "id": "image_ratio", "label": "Legacy image ratio", "options": [{ "value": "3 / 4", "label": "3 / 4" }, { "value": "2 / 3", "label": "2 / 3" }, { "value": "1", "label": "1 / 1" }], "default": "3 / 4" }
    ,{ "type": "range", "id": "desktop_view", "label": "Legacy desktop view", "min": 3, "max": 6, "step": 1, "default": 4 }
    ,{ "type": "select", "id": "mobile_view", "label": "Legacy mobile view", "options": [{ "value": "1", "label": "1" }, { "value": "1.15", "label": "1.15" }, { "value": "1.25", "label": "1.25" }, { "value": "1.5", "label": "1.5" }, { "value": "1.75", "label": "1.75" }, { "value": "2", "label": "2" }], "default": "2" }
    ,{ "type": "range", "id": "desktop_gap", "label": "Legacy desktop gap", "min": 4, "max": 40, "step": 2, "default": 14, "unit": "px" }
  ],
  "blocks": [{
    "type": "tab",
    "name": "Collection tab",
    "settings": [
      { "type": "text", "id": "label", "label": "Tab label" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 24, "step": 4, "default": 8 },
      { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": false },
      { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" }
      ,{ "type": "checkbox", "id": "show_discover", "label": "Legacy show discover link", "default": false }
      ,{ "type": "text", "id": "discover_label", "label": "Legacy discover label", "default": "Discover more" }
    ]
  }],
  "presets": [{ "name": "Custom Tabbed Collection", "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }] }]
}
{% endschema %}
