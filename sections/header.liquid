{% liquid
  assign is_home = false
  if request.page_type == 'index'
    assign is_home = true
  endif
%}
{% render 'brand-colors' %}
{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'olecute-header.js' | asset_url }}" type="module"></script>
<olecute-header id="header-component" class="olecute-header" role="banner" data-home="{{ is_home }}" data-animation-type="{{ section.settings.animation_type | default: 'text_to_logo' }}" data-has-logo="{% if section.settings.logo != blank %}true{% else %}false{% endif %}" data-distance="{{ section.settings.scroll_distance }}" data-cart-url="{{ routes.cart_url }}.js" {% if is_home %}style="--surface: 0"{% endif %}>
  {% if is_home %}
    {% render 'header-desktop-landing', section: section %}
  {% else %}
    {% render 'header-desktop-standard', section: section %}
  {% endif %}
  {% render 'header-mobile', section: section %}
  {% render 'header-desktop-menu-drawer', section: section %}
  {% render 'header-mobile-menu-drawer', section: section %}
  {% render 'header-search-drawer', section: section %}
</olecute-header>
{% schema %}
{
  "name": "Olecute header",
  "tag": "section",
  "class": "olecute-header-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "OLECUTE"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Used on mobile and other pages. Wordmark is the fallback when no image is selected."
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation type",
      "options": [
        {
          "value": "all_logo",
          "label": "All logo"
        },
        {
          "value": "all_text",
          "label": "All text"
        },
        {
          "value": "text_to_logo",
          "label": "Text to logo"
        }
      ],
      "default": "text_to_logo",
      "info": "Desktop homepage animation only. Mobile and other pages always use the logo image."
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "YOU KNOW WHERE TO GET IT"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Homepage animation distance",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 650
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist link",
      "info": "Connect your existing wishlist page. Left unlinked until configured."
    },
    {
      "type": "url",
      "id": "special_link",
      "label": "Rotating icon link"
    },
    {
      "type": "text",
      "id": "special_label",
      "label": "Rotating icon accessible label",
      "default": "Discover Olecute"
    },
    {
      "type": "link_list",
      "id": "drawer_menu",
      "label": "Main navigation"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy menu"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Members Login label",
      "default": "Members Login"
    },
    {
      "type": "url",
      "id": "login_link",
      "label": "Members Login link"
    },
    {
      "type": "text",
      "id": "order_status_label",
      "label": "Order Status label",
      "default": "Order Status"
    },
    {
      "type": "url",
      "id": "order_status_link",
      "label": "Order Status link"
    },
    {
      "type": "text",
      "id": "faq_label",
      "label": "FAQ's label",
      "default": "FAQ's"
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "FAQ's link"
    },
    {
      "type": "text",
      "id": "order_heading",
      "label": "Order support heading",
      "default": "Order Support"
    },
    {
      "type": "text",
      "id": "order_timing",
      "label": "Order support timing"
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Call label",
      "default": "Call"
    },
    {
      "type": "text",
      "id": "call_phone",
      "label": "Call phone number"
    },
    {
      "type": "text",
      "id": "chat_label",
      "label": "Chat label",
      "default": "Chat"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact Support"
    },
    {
      "type": "text",
      "id": "contact_timing",
      "label": "Contact timing"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email"
    },
    {
      "type": "text",
      "id": "support_mobile",
      "label": "Support mobile"
    },
    {
      "type": "text",
      "id": "return_heading",
      "label": "Return heading",
      "default": "Return/Exchange My Order"
    },
    {
      "type": "text",
      "id": "return_policy_label",
      "label": "Return policy label",
      "default": "Return & Exchange Policy"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Submit Request"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Policies heading",
      "default": "Help and Support"
    },
    {
      "type": "url",
      "id": "chat_link",
      "label": "Chat link"
    },
    {
      "type": "url",
      "id": "return_link",
      "label": "Return / exchange link"
    },
    {
      "type": "url",
      "id": "return_policy_link",
      "label": "Return policy link"
    },
    {
      "type": "url",
      "id": "submit_link",
      "label": "Submit request link"
    },
    {
      "type": "image_picker",
      "id": "drawer_image_left",
      "label": "Desktop drawer image left"
    },
    {
      "type": "image_picker",
      "id": "drawer_image_center",
      "label": "Desktop drawer image center"
    },
    {
      "type": "image_picker",
      "id": "drawer_image_right",
      "label": "Desktop drawer image right"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_indicator",
          "label": "Show indicator",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Olecute header",
      "blocks": [
        {
          "type": "nav_item",
          "settings": {
            "label": "New in",
            "link": "",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Shop All",
            "link": "shopify://collections/all",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Kurtis",
            "link": "",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Trending",
            "link": "",
            "show_indicator": true
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Tops",
