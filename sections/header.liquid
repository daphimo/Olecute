{% liquid
  assign is_home = false
  if request.page_type == 'index'
    assign is_home = true
  endif
%}
{% render 'brand-colors' %}
{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'olecute-header.js' | asset_url }}" type="module"></script>
<olecute-header id="header-component" class="olecute-header" role="banner" data-home="{{ is_home }}" data-distance="{{ section.settings.scroll_distance }}" data-cart-url="{{ routes.cart_url }}.js" {% if is_home %}style="--surface: 0"{% endif %}>
  {% if is_home %}
    {% render 'header-desktop-landing', section: section %}
  {% else %}
    {% render 'header-desktop-standard', section: section %}
  {% endif %}
  {% render 'header-mobile', section: section %}
  {% render 'header-desktop-menu-drawer', section: section %}
  {% render 'header-mobile-menu-drawer', section: section %}
  {% render 'header-search-drawer', section: section %}
</olecute-header>
{% schema %}
{
  "name": "Olecute header",
  "tag": "section",
  "class": "olecute-header-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "OLECUTE"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "YOU KNOW WHERE TO GET IT"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Homepage animation distance",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 650
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist link",
      "info": "Connect your existing wishlist page. Left unlinked until configured."
    },
    {
      "type": "url",
      "id": "special_link",
      "label": "Rotating icon link"
    },
    {
      "type": "text",
      "id": "special_label",
      "label": "Rotating icon accessible label",
      "default": "Discover Olecute"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_indicator",
          "label": "Show indicator",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Olecute header",
      "blocks": [
        {
          "type": "nav_item",
          "settings": {
            "label": "New in",
            "link": "",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Shop All",
            "link": "shopify://collections/all",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Kurtis",
            "link": "",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Trending",
            "link": "",
            "show_indicator": true
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Tops",
            "link": "",
            "show_indicator": false
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "Bottom",
            "link": "",
            "show_indicator": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
