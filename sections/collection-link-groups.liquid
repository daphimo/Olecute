{{ 'collection-link-groups.css' | asset_url | stylesheet_tag }}

<section
  class="rs-collection-links"
  style="
    --rs-links-bg: {{ section.settings.background_color }};
    --rs-links-color: {{ section.settings.text_color }};
    --rs-links-border: {{ section.settings.border_color }};
    --rs-links-radius: {{ section.settings.border_radius }}px;
    --rs-links-padding-top: {{ section.settings.padding_top }}px;
    --rs-links-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rs-links-padding-inline: {{ section.settings.padding_horizontal }}px;
  "
>
  <div class="rs-collection-links__inner">
    {% for block in section.blocks %}
      {% assign selected_menu = linklists[block.settings.menu] %}

      {% if selected_menu != blank %}
        <div
          class="rs-collection-links__group"
          {{ block.shopify_attributes }}
        >
          <h3 class="rs-collection-links__title">
            {{ selected_menu.title }}
          </h3>

          {% if selected_menu.links != blank %}
            <div class="rs-collection-links__list">
              {% for link in selected_menu.links %}
                <a
                  href="{{ link.url }}"
                  class="rs-collection-links__link"
                >
                  {{ link.title }}
                </a>

                {% unless forloop.last %}
                  <span
                    class="rs-collection-links__separator"
                    aria-hidden="true"
                  >
                    |
                  </span>
                {% endunless %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection link groups",
  "tag": "section",
  "class": "section-collection-link-groups",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#EEEEEE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6A342D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#D4D4D4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],

  "blocks": [
    {
      "type": "menu_group",
      "name": "Menu group",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],

  "max_blocks": 20,

  "presets": [
    {
      "name": "Collection link groups",
      "blocks": [
        {
          "type": "menu_group"
        },
        {
          "type": "menu_group"
        },
        {
          "type": "menu_group"
        },
        {
          "type": "menu_group"
        }
      ]
    }
  ]
}
{% endschema %}