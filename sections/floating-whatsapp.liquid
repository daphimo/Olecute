{{ 'floating-whatsapp.css' | asset_url | stylesheet_tag }}

{% liquid
  assign whatsapp_color_scope = '#FloatingWhatsapp-' | append: section.id
%}
{% render 'brand-colors', scope: whatsapp_color_scope %}

<floating-whatsapp
  id="FloatingWhatsapp-{{ section.id }}"
  class="floating-whatsapp floating-whatsapp--{{ section.settings.position }}"
  style="--floating-whatsapp-size: {{ section.settings.size }}px; --floating-whatsapp-edge: {{ section.settings.edge_spacing }}px; --floating-whatsapp-bottom: {{ section.settings.bottom_spacing }}px;"
  data-whatsapp-number="{{ section.settings.phone_number | escape }}"
  data-whatsapp-message="{{ section.settings.message | escape }}"
>
  <a
    class="floating-whatsapp__link"
    href="https://wa.me/{{ section.settings.phone_number | remove: '+' | remove: ' ' | remove: '-' }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
  >
    <svg class="floating-whatsapp__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M16.04 3.2A12.8 12.8 0 0 0 5.19 22.79L3.2 28.8l6.18-1.93A12.8 12.8 0 1 0 16.04 3.2Zm0 23.44a10.6 10.6 0 0 1-5.41-1.48l-.39-.23-3.67 1.15 1.19-3.57-.25-.4a10.66 10.66 0 1 1 8.53 4.53Zm5.84-7.97c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59a9.6 9.6 0 0 1-1.78-2.21c-.19-.32-.02-.49.14-.65.15-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.09 1.31 3.3c.16.21 2.25 3.44 5.46 4.82.76.33 1.36.52 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.89-.77 2.15-1.52.27-.75.27-1.39.19-1.52-.08-.14-.29-.22-.61-.38Z"/>
    </svg>
  </a>
</floating-whatsapp>

<script src="{{ 'floating-whatsapp.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Floating WhatsApp",
  "tag": "section",
  "class": "floating-whatsapp-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "WhatsApp number",
      "info": "Include the country code without spaces, for example 919876543210.",
      "default": "918952011127"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Prefilled message",
      "default": "Hi! I would like to know more about your products."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Button size",
      "min": 44,
      "max": 76,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "edge_spacing",
      "label": "Side spacing",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 8,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Floating WhatsApp"
    }
  ]
}
{% endschema %}
