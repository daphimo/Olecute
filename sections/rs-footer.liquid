        {
          "type": "header",
          "content": "Store / Address"
        },
        {
          "type": "textarea",
          "id": "store_icon",
          "label": "Store SVG icon",
          "info": "Paste SVG markup. Leave empty to hide the icon."
        },
        {
          "type": "textarea",
