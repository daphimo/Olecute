        {
          "type": "text",
          "id": "email_2",
          "label": "Email 2"
        },

        {
          "type": "header",
          "content": "Opening hours"
        },
        {
          "type": "textarea",
          "id": "hours_icon",
          "label": "Opening hours SVG icon",
          "info": "Paste SVG markup. Leave empty to hide the icon."
        },
        {
          "type": "text",
          "id": "hours_1",
          "label": "Opening hours 1"
        },
        {
          "type": "text",
          "id": "hours_2",
          "label": "Opening hours 2"
        }
      ]
    },

    {
      "type": "subscribe",
      "name": "Email subscription",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "checkbox",
          "id": "open_by_default_mobile",
          "label": "Open by default on mobile",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "Content",
          "default": "Sign up for new arrivals, special offers and updates."
        },
        {
          "type": "text",
          "id": "email_placeholder",
          "label": "Email field placeholder",
          "default": "Enter your email address"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Subscribe"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Button background",
          "default": "#32166F"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button text color",
          "default": "#FFFFFF"
        },
        {
          "type": "text",
          "id": "success_message",
          "label": "Success message",
          "default": "Thanks for subscribing."
        },
        {
