{{ 'custom-testimonials.css' | asset_url | stylesheet_tag }}

{% liquid
  assign slider_type = 'slide'
  assign show_controls = false
  assign autoplay = false
  if section.blocks.size > section.settings.mobile_cards
    assign slider_type = 'loop'
    assign show_controls = true
  endif
  if section.settings.autoplay and show_controls
    assign autoplay = true
  endif
%}

<section
  class="splide custom-splide custom-testimonials"
  data-custom-splide
  data-pagination-type="progress"
  data-splide-options='{
    "type": {{ slider_type | json }},
    "perPage": {{ section.settings.desktop_cards | json }},
    "gap": {{ section.settings.desktop_gap | append: "px" | json }},
    "padding": { "right": "6%" },
    "arrows": {{ show_controls | json }},
    "pagination": {{ show_controls | json }},
    "autoplay": {{ autoplay | json }},
    "interval": {{ section.settings.autoplay_interval | json }},
    "speed": 650,
    "pauseOnHover": true,
    "pauseOnFocus": true,
    "drag": true,
    "breakpoints": {
      "749": {
        "perPage": {{ section.settings.mobile_cards | json }},
        "gap": {{ section.settings.mobile_gap | append: "px" | json }},
        "padding": { "right": "14%" }
      }
    }
  }'
  style="
    --custom-splide-interval: {{ section.settings.autoplay_interval }}ms;
    --custom-testimonials-padding-top: {{ section.settings.padding_top }}px;
    --custom-testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-testimonials-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --custom-testimonials-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --custom-testimonials-margin-top: {{ section.settings.margin_top }}px;
    --custom-testimonials-margin-bottom: {{ section.settings.margin_bottom }}px;
  "
  aria-label="Customer testimonials"
>
  <div class="custom-testimonials__inner">
    {% if section.settings.eyebrow != blank %}<p class="custom-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <header class="custom-testimonials__header">
      <div>
        {% if section.settings.heading != blank %}<h2 class="custom-testimonials__heading">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.show_rating_summary %}
          <div class="custom-testimonials__summary" aria-label="Rated {{ section.settings.rating }} out of 5. {{ section.settings.rating_text | escape }} {{ section.settings.trust_text | escape }}">
            <span class="custom-testimonials__stars" aria-hidden="true">
              {% for i in (1..5) %}<svg viewBox="0 0 20 20"><path d="m10 2 2.3 4.8 5.2.7-3.8 3.7.9 5.3-4.6-2.5-4.6 2.5.9-5.3-3.8-3.7 5.2-.7Z"/></svg>{% endfor %}
            </span>
            <span class="custom-testimonials__rating-number">{{ section.settings.rating }}</span>
            {% if section.settings.rating_text != blank %}<span class="custom-testimonials__rating-text">{{ section.settings.rating_text | escape }}</span>{% endif %}
            {% if section.settings.trust_text != blank %}<span class="custom-testimonials__trust">{{ section.settings.trust_text | escape }}</span>{% endif %}
          </div>
        {% endif %}
      </div>
      {% if show_controls %}
        <div class="splide__arrows custom-testimonials__navigation">
          <button class="splide__arrow splide__arrow--prev" type="button" aria-label="Previous testimonials"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
          <button class="splide__arrow splide__arrow--next" type="button" aria-label="Next testimonials"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
        </div>
      {% endif %}
    </header>

    <div class="splide__track custom-testimonials__track">
      <ul class="splide__list custom-testimonials__list" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign initials = block.settings.initials
            if initials == blank
              assign initials = block.settings.customer_name | slice: 0, 1
            endif
            assign image_alt = block.settings.image_alt | default: block.settings.customer_name
            assign image_loading = 'lazy'
            if forloop.index <= section.settings.desktop_cards
              assign image_loading = 'eager'
            endif
          %}
          <li class="splide__slide custom-testimonials__slide" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}<a class="custom-testimonials__card" href="{{ block.settings.link }}" aria-label="Review by {{ block.settings.customer_name | escape }}">{% else %}<article class="custom-testimonials__card">{% endif %}
              <div class="custom-testimonials__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 900 | image_tag: class: 'custom-testimonials__image', widths: '280, 420, 560, 720, 900', sizes: '(max-width:749px) 74vw, 24vw', loading: image_loading, alt: image_alt }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-testimonials__placeholder' }}
                {% endif %}
                {% if block.settings.badge != blank %}<span class="custom-testimonials__badge">{{ block.settings.badge | escape }}</span>{% endif %}
              </div>
              <div class="custom-testimonials__content">
                <span class="custom-testimonials__card-rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {% for i in (1..5) %}<svg class="{% if i <= block.settings.rating %}is-filled{% endif %}" viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2 2.3 4.8 5.2.7-3.8 3.7.9 5.3-4.6-2.5-4.6 2.5.9-5.3-3.8-3.7 5.2-.7Z"/></svg>{% endfor %}
                </span>
                <blockquote class="custom-testimonials__review">{{ block.settings.review | escape }}</blockquote>
                <div class="custom-testimonials__customer">
                  <span class="custom-testimonials__initials" aria-hidden="true">{{ initials | escape }}</span>
                  <span class="custom-testimonials__customer-copy">
                    <span class="custom-testimonials__name">{{ block.settings.customer_name | escape }}</span>
                    {% if block.settings.verified_text != blank %}<span class="custom-testimonials__verified">{{ block.settings.verified_text | escape }}</span>{% endif %}
                  </span>
                </div>
              </div>
            {% if block.settings.link != blank %}</a>{% else %}</article>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom testimonials",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "blocks": [{
    "type": "testimonial", "name": "Testimonial",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text" },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Co-ord set" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "review", "label": "Review", "default": "The quality, fit, and thoughtful details exceeded my expectations. I absolutely loved it." },
      { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Customer name" },
      { "type": "text", "id": "initials", "label": "Initials" },
      { "type": "text", "id": "verified_text", "label": "Verification text", "default": "Verified purchase" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real women, real reviews" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What our customers <em>are saying</em>" },
    { "type": "checkbox", "id": "show_rating_summary", "label": "Show rating summary", "default": true },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating count/text" },
    { "type": "text", "id": "trust_text", "label": "Trust text", "default": "Trusted by 1 Million+ women across India" },
    { "type": "range", "id": "desktop_cards", "label": "Desktop cards per view", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_gap", "label": "Desktop gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_cards", "label": "Mobile cards per view", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 28, "step": 2, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": false },
    { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval", "min": 3000, "max": 9000, "step": 500, "unit": "ms", "default": 5000, "visible_if": "{{ section.settings.autoplay }}" },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Section margins" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Custom testimonials", "blocks": [{ "type": "testimonial" },{ "type": "testimonial" },{ "type": "testimonial" },{ "type": "testimonial" },{ "type": "testimonial" }] }]
}
{% endschema %}
