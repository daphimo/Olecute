    .custom-main-product__purchase>.custom-size-chart{background:var(--color-background);border:1px solid var(--color-background-secondary);box-shadow:0 12px 38px color-mix(in srgb,var(--color-primary-dark) 18%,transparent)}
    .custom-main-product__video-toggle span,.custom-main-product__fit,.custom-main-product__counter,.custom-main-product__mobile-highlights .custom-highlights span{background:color-mix(in srgb,var(--color-background) 84%,transparent);box-shadow:0 2px 10px color-mix(in srgb,var(--color-background-secondary) 65%,transparent)}
  }
  @media(min-width:951px){
    .custom-main-product-section{display:block!important;height:auto!important;min-height:0!important;overflow:visible!important;contain:none!important}
    .custom-main-product.custom-commerce{--pdp-sticky-top:var(--header-group-height,var(--header-height,0px));--pdp-viewport-height:calc(100svh - var(--pdp-sticky-top));display:grid!important;grid-template-columns:32% 34% 32%;grid-template-rows:auto;grid-template-areas:"intro media purchase";column-gap:1%;width:100%;height:auto!important;min-height:var(--pdp-viewport-height);align-items:start;padding:0 1.5vw;overflow:visible!important;contain:none!important}
    .custom-main-product__intro,.custom-main-product__purchase{position:sticky;top:var(--pdp-sticky-top);box-sizing:border-box;width:100%;max-width:100%;height:var(--pdp-viewport-height);min-height:0;align-self:start;overflow:hidden}
    .custom-main-product__intro{display:flex;justify-content:flex-start;padding:1vw 0}
    .custom-main-product__heading{flex:0 0 auto}
    .custom-main-product__editorial-video{flex:0 1 19vw;min-height:0;margin:auto 0 1vw auto}
    .custom-main-product__accordions{position:static;flex:0 0 auto;width:100%;max-height:42%;margin-top:auto;padding:0;overflow:auto;background:var(--color-background);overscroll-behavior:contain}
    .custom-main-product__media{position:static;display:block;width:100%;max-width:100%;height:auto!important;min-height:var(--pdp-viewport-height);overflow:visible!important;overscroll-behavior:auto;contain:none!important}
    .custom-main-product__media-track{position:static;display:block;width:100%;height:auto!important;max-height:none!important;overflow:visible!important;contain:none!important}
    .custom-main-product__media-item{position:relative;display:block;width:100%;height:var(--pdp-viewport-height);min-height:var(--pdp-viewport-height);margin:0 0 .3vw;overflow:hidden}
    .custom-main-product__media-item:last-child{margin-bottom:0}
    .custom-main-product__media-item>img,.custom-main-product__media-item>svg{display:block;width:100%;height:100%;object-fit:cover;object-position:top}
    .custom-main-product__media-item :is(video,iframe,model-viewer){width:100%;height:100%;min-height:0}
    .custom-main-product__purchase{display:flex;padding:1vw 0 0 5px}
    .custom-main-product__sizing{flex:0 0 auto}
    .custom-main-product__purchase>.custom-variants{flex:0 0 auto}
    .custom-main-product .custom-variants fieldset{margin:clamp(6px,1.2svh,12px) 0}
    .custom-main-product .custom-variants button{min-height:clamp(36px,5.5svh,44px)}
    .custom-main-product__desktop-price{flex:0 0 auto;margin-top:clamp(10px,3svh,25px)}
    .custom-main-product__styles{flex:0 1 auto;min-height:0;margin-top:auto;overflow:hidden}
    .custom-main-product__styles a{height:min(var(--style-height),18svh)}
    .custom-main-product__actions,.custom-main-product__benefits{flex:0 0 auto}
    .custom-main-product__purchase>.custom-size-chart{inset:var(--pdp-sticky-top) 0 0;width:100vw;max-width:none;height:var(--pdp-viewport-height);margin:0;padding:clamp(24px,6vh,60px) 24px 0;background:var(--color-background)}
    .custom-main-product__purchase>.custom-size-chart::backdrop{background:var(--color-background);opacity:1}
  }
  @media(prefers-reduced-motion:reduce){.custom-main-product *{scroll-behavior:auto!important}.custom-main-product__accordion-panel,.custom-main-product__accordion svg,.custom-main-product__video-toggle{transition:none}}
{% endstylesheet %}

{% javascript %}
  (()=>{const roots=document.querySelectorAll('.custom-main-product:not([data-main-ready])');for(const root of roots){root.dataset.mainReady='true';const gallery=root.querySelector('[data-product-media-gallery]'),track=root.querySelector('.custom-main-product__media-track'),items=[...root.querySelectorAll('[data-product-media]')],counter=root.querySelector('[data-media-current]');if(gallery&&items.length&&counter&&'IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{const visible=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];if(visible)counter.textContent=visible.target.dataset.mediaIndex},{root:track,threshold:[.45,.65,.85]});items.forEach(item=>observer.observe(item))}root.addEventListener('click',event=>{const video=event.target.closest('[data-video-toggle]');if(video){const expanded=video.toggleAttribute('data-expanded');video.setAttribute('aria-label',expanded?'Reduce product video':'Enlarge product video')}const trigger=event.target.closest('[data-accordion-trigger]');if(!trigger)return;const opening=trigger.getAttribute('aria-expanded')!=='true';root.querySelectorAll('[data-accordion-trigger]').forEach(button=>{button.setAttribute('aria-expanded','false');const panel=document.getElementById(button.getAttribute('aria-controls'));panel?.removeAttribute('data-open');panel?.setAttribute('inert','')});if(opening){trigger.setAttribute('aria-expanded','true');const panel=document.getElementById(trigger.getAttribute('aria-controls'));panel?.setAttribute('data-open','');panel?.removeAttribute('inert')}});root.addEventListener('custom:variant-change',event=>{const button=root.querySelector('.custom-main-product__buy');if(button)button.disabled=!event.detail.variant.available})}})();
{% endjavascript %}

