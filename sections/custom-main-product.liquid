{% liquid
  assign selected = product.selected_or_first_available_variant
  assign style_value = product.metafields.custom.style.value
  assign color_value = product.metafields.custom.primary_color.value
  assign fit_value = product.metafields.custom.model_fit_check.value
  assign product_family = product.metafields.custom.product_family.value
  assign product_video = product.media | where: 'media_type', 'video' | first
  if product_video == blank
    assign product_video = product.media | where: 'media_type', 'external_video' | first
  endif
  assign measurement_keys = 'chest,waist,hips,bust,to_fit_waist,pyjama_waist,inseam_length,front_length,across_shoulder' | split: ','
  assign has_measurements = false
  for variant in product.variants
    for key in measurement_keys
      if variant.metafields.custom[key].value != blank
        assign has_measurements = true
        break
      endif
    endfor
    if has_measurements
      break
    endif
  endfor
%}
{% render 'brand-colors', scope: '.custom-main-product' %}
<custom-product-options class="custom-commerce custom-main-product" data-section-id="{{ section.id }}" {% render 'custom-product-data', product: product %}>
  <div class="custom-main-product__intro">
    <div class="custom-main-product__desktop-highlights">{% render 'custom-product-highlights', product: product %}</div>
    <div class="custom-main-product__heading">
      <h1>{{ product.title | escape }}</h1>
      <div class="custom-main-product__desktop-wishlist">{% render 'custom-wishlist-button', product: product, variant: selected %}</div>
      <div class="custom-main-product__mobile-price" data-custom-price>{% render 'custom-product-price', product: product, variant: selected, show_discount: true %}</div>
    </div>
    {% if style_value != blank %}<p class="custom-main-product__mobile-style">{{ style_value | escape }}</p>{% endif %}
    <dl class="custom-main-product__meta">
      {% if style_value != blank %}<div><dt>Style</dt><dd>{{ style_value | escape }}</dd></div>{% endif %}
      {% if color_value != blank %}<div><dt>Color</dt><dd>{{ color_value | escape }}</dd></div>{% endif %}
      {% if fit_value != blank %}<div><dt>Model Fit Check</dt><dd>{{ fit_value | escape }}</dd></div>{% endif %}
    </dl>
    {% if product_video != blank %}
      <div class="custom-main-product__editorial-video">
        {% case product_video.media_type %}
          {% when 'video' %}{{ product_video | video_tag: autoplay: true, muted: true, loop: true, controls: false, playsinline: true, preload: 'metadata', image_size: '420x' }}
          {% when 'external_video' %}{{ product_video | external_video_tag: autoplay: true, muted: true, loop: true, loading: 'eager' }}
        {% endcase %}
      </div>
    {% endif %}

  <div class="custom-main-product__accordions">
    {% assign shipping_content = section.settings.shipping_content | default: shop.shipping_policy.body %}
    {% assign returns_content = section.settings.returns_content | default: shop.refund_policy.body %}
    {% assign accordion_titles = 'Details & Description|Shipping & Delivery|Return & Exchange' | split: '|' %}
    {% for title in accordion_titles %}
      {% case forloop.index %}{% when 1 %}{% assign accordion_content = product.description %}{% when 2 %}{% assign accordion_content = shipping_content %}{% when 3 %}{% assign accordion_content = returns_content %}{% endcase %}
      <div class="custom-main-product__accordion">
        <button type="button" aria-expanded="false" aria-controls="ProductAccordion-{{ section.id }}-{{ forloop.index }}" data-accordion-trigger><span>{{ title }}</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg></button>
        <div id="ProductAccordion-{{ section.id }}-{{ forloop.index }}" class="custom-main-product__accordion-panel" inert><div><div class="rte">{{ accordion_content }}</div></div></div>
      </div>
      {% if forloop.first %}
        {% capture product_specifications %}{% render 'custom-product-specifications', product: product %}{% endcapture %}
        {% assign product_specifications = product_specifications | strip %}
        {% if product_specifications != blank %}
          <div class="custom-main-product__accordion">
            <button type="button" aria-expanded="false" aria-controls="ProductSpecifications-{{ section.id }}" data-accordion-trigger><span>Specifications</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg></button>
            <div id="ProductSpecifications-{{ section.id }}" class="custom-main-product__accordion-panel" inert><div>{{ product_specifications }}</div></div>
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
  </div>

  <div class="custom-main-product__media" data-product-media-gallery tabindex="0" aria-label="Product media">
    {% if fit_value != blank %}<span class="custom-main-product__fit">{{ fit_value | escape }}</span>{% endif %}
    <div class="custom-main-product__mobile-wishlist">{% render 'custom-wishlist-button', product: product, variant: selected %}</div>
    <div class="custom-main-product__media-track">
      {% assign gallery_index = 0 %}
      {% for media in product.media %}
        {% if media.media_type != 'video' and media.media_type != 'external_video' %}
        {% assign gallery_index = gallery_index | plus: 1 %}
        {% liquid
          assign media_loading = 'lazy'
          assign media_priority = 'auto'
          if gallery_index == 1
            assign media_loading = 'eager'
            assign media_priority = 'high'
          endif
        %}
        <div class="custom-main-product__media-item" data-product-media data-media-index="{{ gallery_index }}">
          {% case media.media_type %}
            {% when 'image' %}
              {{ media.preview_image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 900, 1200', sizes: '(max-width: 749px) calc(100vw - 12px), 34vw', loading: media_loading, fetchpriority: media_priority, decoding: 'async', alt: media.alt | default: product.title }}
            {% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
          {% endcase %}
        </div>
        {% endif %}
      {% else %}
        <div class="custom-main-product__media-item">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endfor %}
    </div>
    {% if product_video != blank %}
      <button type="button" class="custom-main-product__mobile-video custom-main-product__video-toggle" data-video-toggle aria-label="Enlarge product video">
        {% case product_video.media_type %}
          {% when 'video' %}{{ product_video | video_tag: autoplay: true, muted: true, loop: true, controls: false, playsinline: true, preload: 'metadata', image_size: '420x' }}
          {% when 'external_video' %}{{ product_video | external_video_tag: autoplay: true, muted: true, loop: true, loading: 'eager' }}
        {% endcase %}
        <span>Touch to zoom in</span>
      </button>
    {% endif %}
    <span class="custom-main-product__counter" aria-live="polite"><b data-media-current>1</b>/{{ gallery_index | at_least: 1 }}</span>
    <div class="custom-main-product__mobile-highlights">{% render 'custom-product-highlights', product: product %}</div>
  </div>

  <div class="custom-main-product__purchase">
    {% if product_family != blank %}
        <div class="custom-main-product__styles">
          <p>More Styles</p>
          <div>
            {% for style_product in product_family %}
              <a href="{{ style_product.url }}" aria-label="{{ style_product.title | escape }}">
                {% if style_product.featured_image %}{{ style_product.featured_image | image_url: width: 360 | image_tag: widths: '120, 180, 240, 360', sizes: '80px', loading: 'lazy', alt: style_product.featured_image.alt | default: style_product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
              </a>
            {% endfor %}
          </div>
        </div>
    {% endif %}
    {% if has_measurements %}
      <div class="custom-main-product__sizing">
        <div class="custom-main-product__size-head">{% render 'custom-size-switcher' %}<button type="button" data-custom-chart-open>What's my size?</button></div>
        <div class="custom-measurements"><span>Chest <b data-measure="chest">-</b></span><span>High Waist <b data-measure="waist">-</b></span><span>Hips <b data-measure="hips">-</b></span><span>Bust <b data-measure="bust">-</b></span><span>To Fit Waist <b data-measure="to_fit_waist">-</b></span><span>Pyjama Waist <b data-measure="pyjama_waist">-</b></span><span>Inseam Length <b data-measure="inseam_length">-</b></span><span>Front Length <b data-measure="front_length">-</b></span><span>Across Shoulder <b data-measure="across_shoulder">-</b></span></div>
      </div>
    {% endif %}
    {% render 'custom-variant-selector', product: product, selected_variant: selected %}
    <div class="custom-main-product__desktop-price" data-custom-price>{% render 'custom-product-price', product: product, variant: selected, show_discount: true %}</div>
    <div class="custom-main-product__actions">
      {% render 'custom-add-to-cart', variant: selected %}
      <form action="{{ routes.cart_add_url }}" method="post" data-buy-now-form><input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="/checkout"><button type="submit" class="custom-main-product__buy" {% unless selected.available %}disabled{% endunless %}>BUY NOW</button></form>
    </div>
    <div class="custom-main-product__benefits">
      {% for block in section.blocks %}{% if block.type == 'benefit' %}<div class="custom-main-product__benefit" {{ block.shopify_attributes }}>{% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 80 | image_tag: widths: '40, 80', sizes: '28px', loading: 'lazy' }}{% endif %}<span>{{ block.settings.text | escape | newline_to_br }}</span></div>{% endif %}{% endfor %}
    </div>
    {% if has_measurements %}{% render 'custom-size-chart', product: product %}{% endif %}
  </div>

</custom-product-options>

