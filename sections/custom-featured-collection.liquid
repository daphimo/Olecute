{% assign featured_collection = section.settings.collection %}
{% if featured_collection != blank and featured_collection.products.size > 0 %}
  {{ 'custom-featured-collection.css' | asset_url | stylesheet_tag }}
  <section
    class="section section--page-width custom-commerce custom-featured-collection"
    {% if section.settings.heading != blank %}aria-labelledby="FeaturedCollectionHeading-{{ section.id }}"{% else %}aria-label="{{ featured_collection.title | escape }}"{% endif %}
    style="--featured-columns: {{ section.settings.desktop_columns }}; --featured-gap: {{ section.settings.desktop_gap }}px; --featured-mobile-view: {{ section.settings.mobile_products_per_view }}; --featured-mobile-gap: {{ section.settings.mobile_gap }}px; --featured-top: {{ section.settings.padding_top }}px; --featured-bottom: {{ section.settings.padding_bottom }}px; --featured-mobile-top: {{ section.settings.mobile_padding_top }}px; --featured-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;"
  >
    {% if section.settings.heading != blank or section.settings.show_discover_more and section.settings.discover_more_label != blank %}
      <div class="custom-featured-collection__header">
        {% if section.settings.heading != blank %}<h2 id="FeaturedCollectionHeading-{{ section.id }}" class="custom-featured-collection__heading {% if section.settings.custom %}custom_font_design{% endif %}">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.show_discover_more and section.settings.discover_more_label != blank %}<a class="custom-featured-collection__discover" href="{{ featured_collection.url }}">{{ section.settings.discover_more_label | escape }}</a>{% endif %}
      </div>
    {% endif %}
    <div class="custom-featured-collection__track" tabindex="0" role="list" aria-label="{{ featured_collection.title | escape }} products">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% assign eager = false %}
        {% if section.index == 1 and forloop.first %}{% assign eager = true %}{% endif %}
        <div class="custom-featured-collection__item" role="listitem">
          {% render 'custom-product-card', product: product, eager: eager %}
        </div>
      {% endfor %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="section section--page-width"><p>{% if featured_collection == blank %}Select a collection to display featured products.{% else %}This collection has no products yet.{% endif %}</p></div>
{% endif %}

{% schema %}
{
  "name": "Custom Featured Products",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "custom", "label": "Apply Custom Font", "default": false, "info": "Apply bold to field to apply custom font" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Most Wanted" },
    { "type": "range", "id": "products_to_show", "label": "Products to Show", "min": 2, "max": 16, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_discover_more", "label": "Show Discover More", "default": true },
    { "type": "text", "id": "discover_more_label", "label": "Discover More Label", "default": "Discover More" },
    { "type": "header", "content": "Desktop" },
    { "type": "range", "id": "desktop_columns", "label": "Desktop Columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_gap", "label": "Desktop Card Gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Mobile" },
    { "type": "select", "id": "mobile_products_per_view", "label": "Mobile Products Per View", "default": "1.25", "options": [
      { "value": "1", "label": "1" }, { "value": "1.25", "label": "1.25" }, { "value": "1.5", "label": "1.5" },
      { "value": "2", "label": "2" }, { "value": "2.25", "label": "2.25" }, { "value": "2.5", "label": "2.5" }
    ] },
    { "type": "range", "id": "mobile_gap", "label": "Mobile Card Gap", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop Top Padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop Bottom Padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile Top Padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile Bottom Padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 20 }
  ],
  "presets": [{ "name": "Custom Featured Collection" }]
}
{% endschema %}
