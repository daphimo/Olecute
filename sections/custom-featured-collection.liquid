{{ 'custom-featured-collection.css' | asset_url | stylesheet_tag }}

{% liquid
  assign featured_collection = section.settings.collection
  assign cta_url = section.settings.cta_url | default: featured_collection.url
%}

<section
  class="custom-featured-collection"
  style="
    --custom-featured-columns: {{ section.settings.desktop_columns }};
    --custom-featured-gap: {{ section.settings.product_gap }}px;
    --custom-featured-padding-top: {{ section.settings.padding_top }}px;
    --custom-featured-padding-bottom: {{ section.settings.padding_bottom }}px;
    --custom-featured-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --custom-featured-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --custom-featured-margin-top: {{ section.settings.margin_top }}px;
    --custom-featured-margin-bottom: {{ section.settings.margin_bottom }}px;
  "
>
  <div class="custom-featured-collection__panel">
    <div class="custom-featured-collection__inner">
      <header class="custom-featured-collection__header">
        <div>
          {% if section.settings.eyebrow != blank %}<p class="custom-featured-collection__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
          {% if section.settings.heading != blank %}<h2 class="custom-featured-collection__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
          {% if section.settings.description != blank %}<div class="custom-featured-collection__description">{{ section.settings.description }}</div>{% endif %}
        </div>
        {% if section.settings.show_cta and section.settings.cta_label != blank and cta_url != blank %}
          <a class="custom-featured-collection__cta" href="{{ cta_url }}">
            {{ section.settings.cta_label | escape }}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
          </a>
        {% endif %}
      </header>

      {% if featured_collection != blank and featured_collection.products_count > 0 %}
        <div class="custom-featured-collection__products">
          {% for product in featured_collection.products limit: section.settings.products_to_show %}
            {% assign image_loading = 'lazy' %}
            {% if forloop.index <= 2 %}{% assign image_loading = 'eager' %}{% endif %}
            {% render 'custom-featured-product-card', product: product, section_id: section.id, show_rating: section.settings.show_rating, image_loading: image_loading %}
          {% endfor %}
        </div>
      {% elsif request.design_mode %}
        <p>Select a collection containing products to preview this section.</p>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_bottom_wave %}
    <svg class="custom-featured-collection__wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 0H1440V57C1380 43 1330 43 1270 58C1210 73 1160 77 1095 61C1030 45 985 42 925 56C865 70 810 79 745 64C680 49 635 43 575 56C515 69 460 78 395 64C330 50 285 45 225 58C165 71 100 75 0 55V0Z"/>
    </svg>
  {% endif %}
</section>

{% schema %}
{
  "name": "Custom featured",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just dropped" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh off the runway." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>New designs every week — pure cotton, made in Jaipur.</p>" },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop new arrivals" },
    { "type": "url", "id": "cta_url", "label": "CTA link", "info": "Defaults to the selected collection." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "desktop_columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 6 },
    { "type": "range", "id": "product_gap", "label": "Product gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "checkbox", "id": "show_rating", "label": "Show ratings", "default": true },
    { "type": "checkbox", "id": "show_bottom_wave", "label": "Show bottom wave", "default": true },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Section margins" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Custom featured" }]
}
{% endschema %}
