  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Infinite gallery grid",
      "blocks": [
        {
          "type": "gallery_group"
        },
        {
          "type": "gallery_group"
        },
        {
          "type": "gallery_group"
        }
      ]
    }
  ]
}
{% endschema %}