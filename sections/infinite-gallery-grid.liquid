        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link_3",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "alt_3",
          "label": "Alt text"
        },

        {
          "type": "header",
          "content": "Image 4"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link_4",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "alt_4",
          "label": "Alt text"
        },

        {
          "type": "header",
          "content": "Image 5"
        },
        {
          "type": "image_picker",
          "id": "image_5",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link_5",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "alt_5",
          "label": "Alt text"
        }
      ]
