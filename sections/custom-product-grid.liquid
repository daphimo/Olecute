<section class="custom-commerce custom-product-grid-section">
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
  <div class="custom-product-grid">
    {% for product in section.settings.collection.products limit: section.settings.limit %}
      {% assign eager = false %}{% if section.index == 1 and forloop.first %}{% assign eager = true %}{% endif %}
      {% render 'custom-product-card', product: product, eager: eager %}
    {% else %}{% if request.design_mode %}<p>Select a collection to display custom product cards.</p>{% endif %}{% endfor %}
  </div>
</section>
{% schema %}
{"name":"Custom product cards","settings":[{"type":"text","id":"heading","label":"Heading","default":"Discover the collection"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":24,"step":1,"default":8}],"presets":[{"name":"Custom product cards"}]}
{% endschema %}
