<div class="olecute-header__mobile">
  <div class="olecute-header__mobile-left">
    {% render 'header-menu-trigger', section: section, drawer: 'mobile-menu' %}
    {% render 'header-search-trigger', section: section, mobile: true %}
  </div>
  <div class="olecute-header__mobile-brand">
    {% render 'header-logo', section: section, context: 'mobile' %}
    <div class="olecute-header__mobile-quote" data-mobile-quote>{% render 'header-quote', section: section %}</div>
  </div>
  {% render 'header-mobile-icons', section: section %}
</div>
