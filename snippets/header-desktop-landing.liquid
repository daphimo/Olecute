<div class="olecute-header__desktop olecute-header__landing">
  <div class="olecute-header__landing-nav" data-landing-nav>{% render 'header-block-items', section: section %}</div>
  <div class="olecute-header__landing-quote" data-landing-quote>{% render 'header-quote', section: section %}</div>
  <div class="olecute-header__landing-menu" data-landing-menu>{% render 'header-menu-trigger', section: section, drawer: 'desktop-menu' %}</div>
  <div class="olecute-header__wordmark" data-wordmark>{% render 'header-logo', section: section, context: 'landing' %}</div>
  {% render 'header-desktop-icons', section: section %}
</div>
