{% liquid
  assign selected = variant | default: product.selected_or_first_available_variant
  assign size_label = ''
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign position = forloop.index0
      assign size_label = selected.options[position]
    endif
  endfor
  assign image = selected.featured_image | default: product.featured_image
%}
{% capture item %}{"productId":{{ product.id | append: '' | json }},"variantId":{{ selected.id | append: '' | json }},"productHandle":{{ product.handle | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{% if image %}{{ image | image_url: width: 720 | json }}{% else %}""{% endif %},"price":{{ selected.price | money | json }},"size":{{ size_label | json }}}{% endcapture %}
<custom-wishlist-control>
<button type="button" class="custom-wishlist-button" data-custom-wishlist data-wishlist-item="{{ item | escape }}" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false" {% unless selected %}disabled{% endunless %}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
</button>

</custom-wishlist-control>
